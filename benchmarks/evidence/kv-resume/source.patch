+// Reproduce a long-generation checkpoint whose prefix exceeds the physical ring.
+// Full pages are shared from Host; the partial tail alone must be restored and copied.
+void test_host_prefix_fork(ninfer::DeviceContext& device) {
+    ninfer::LayoutBuilder builder;
+    ninfer::DeviceKVPagePoolSpec spec{
+        .page_group_count = 8,
+        .allow_logical_reservation = true,
+        .geometry = {.page_tokens = 64,
+                     .device_plane_order = ninfer::PagedKVPlaneOrder::PageMajor,
+                     .planes = {{.dtype = ninfer::DType::BF16, .leading_extent = 8,
+                                 .head_extent = 2}}},
+    };
+    const auto layout = ninfer::plan_device_kv_page_pool(builder, spec);
+    const auto table_layout = ninfer::plan_kv_execution_tables(
+        builder, {.logical_page_capacity = 16, .table_rows = 2});
+    ninfer::DeviceArena arena(builder.finish(256));
+    const ninfer::DeviceSpan backing{arena.base(), arena.capacity()};
+    ninfer::DeviceKVPagePool physical(backing, layout);
+    ninfer::KVExecutionTablePool tables(backing, table_layout, physical);
+    const auto host_layout = ninfer::plan_host_kv_page_layout(physical.geometry());
+    const std::array host_layouts{host_layout};
+    ninfer::HostKVArena host(host_layout.page_stride * 32, host_layouts);
+    store::LogicalKVPageStore pages(physical, 40);
+    store::HostKVExtentStore extents(host, 32);
+    store::KVAddressSpaceStore addresses(pages, tables, 4, 16);
+    const auto source = addresses.create_active(16, 0, {});
+    expect(source.has_value(), "Host prefix fixture source");
+    const auto& plane = physical.plane(0);
+    const auto payload = [&](std::int32_t index) {
+        return static_cast<unsigned char*>(plane.data) +
+               index * plane.nb[3];
+    };
+    // Build thirteen logical pages with at most one resident at a time.
+    for (std::uint32_t index = 0; index < 13; ++index) {
+        if (index != 0) {
+            auto activation = addresses.prepare_activation(*source, 16, 0, std::nullopt, true);
+            addresses.commit_activation(std::move(activation), device.stream);
+        }
+        const std::uint32_t frontier = index == 12 ? 12 * 64 + 17 : (index + 1) * 64;
+        addresses.ensure_mapped_to_tokens(*source, frontier, device.stream);
+        const auto logical = addresses.logical_page(*source, index);
+        device.synchronize();
+        CUDA_CHECK(cudaMemsetAsync(payload(read_block_table(tables, 0, index + 1)[index]), index + 1,
+                                    plane.nb[3], device.stream));
+        addresses.commit_frontier(*source, frontier);
+        addresses.set_checkpoint_requirement(*source, frontier);
+        addresses.deactivate(*source);
+        device.synchronize();
+        const std::array members{logical};
+        auto backup = extents.prepare(pages, members);
