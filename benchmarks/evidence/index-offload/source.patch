+#pragma once
+
+#include <cstddef>
+#include <cuda_runtime_api.h>
+
+namespace ninfer {
+
+// Owning, pinned system-memory allocation with a stable CUDA device alias.
+// Kernels may use device_data(); the CPU may use host_data() only after ordering
+// prior GPU accesses. The allocation must outlive every graph referring to it.
+// This is explicit host storage, independent of automatic device-memory fallback.
+class MappedHostBuffer {
+public:
+    explicit MappedHostBuffer(std::size_t size_bytes);
+    ~MappedHostBuffer();
+    MappedHostBuffer(const MappedHostBuffer&) = delete;
+    MappedHostBuffer& operator=(const MappedHostBuffer&) = delete;
+
+    [[nodiscard]] void* host_data() const noexcept { return host_; }
+    [[nodiscard]] void* device_data() const noexcept { return device_; }
+    [[nodiscard]] std::size_t size() const noexcept { return bytes_; }
+    // Stream-ordered upload from pinned storage; valid during graph capture.
+    [[nodiscard]] cudaError_t copy_to_device_async(void* destination, std::size_t count,
+                                                  std::size_t offset, cudaStream_t stream) const;
+
+private:
+    void* host_ = nullptr;
+    void* device_ = nullptr;
+    std::size_t bytes_ = 0;
+};
+
+} // namespace ninfer
--- /dev/null
+++ b/src/core/mapped_host_buffer.cpp
@@ -0,0 +1,31 @@
+#include "core/mapped_host_buffer.h"
+#include "core/device.h"
+
+namespace ninfer {
+
+MappedHostBuffer::MappedHostBuffer(std::size_t size_bytes) : bytes_(size_bytes) {
+    if (bytes_ == 0) { return; }
+    CUDA_CHECK(cudaHostAlloc(&host_, bytes_, cudaHostAllocMapped));
+    const cudaError_t status = cudaHostGetDevicePointer(&device_, host_, 0);
+    if (status != cudaSuccess) {
+        (void)cudaFreeHost(host_);
+        host_ = nullptr;
+        CUDA_CHECK(status);
+    }
+}
+
+MappedHostBuffer::~MappedHostBuffer() {
+    // As for DeviceBuffer, the caller must complete outstanding accesses before
+    // releasing storage; graph ownership remains with its execution owner.
+    if (host_ != nullptr) { (void)cudaFreeHost(host_); }
+}
+
+cudaError_t MappedHostBuffer::copy_to_device_async(void* destination, std::size_t count,
+                                                 std::size_t offset, cudaStream_t stream) const {
+    if (offset > bytes_ || count > bytes_ - offset) { return cudaErrorInvalidValue; }
+    if (count == 0) { return cudaSuccess; }
+    return cudaMemcpyAsync(destination, static_cast<const char*>(host_) + offset,
+                           count, cudaMemcpyHostToDevice, stream);
+}
+
