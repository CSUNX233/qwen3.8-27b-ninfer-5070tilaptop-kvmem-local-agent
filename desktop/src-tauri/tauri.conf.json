{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pmod",
  "version": "1.0.0",
  "identifier": "com.pmod.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pmod",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": true,
        "focus": true,
        "additionalBrowserArgs": "--enable-gpu-rasterization --ignore-gpu-blocklist --disable-smooth-scrolling --disable-features=CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
