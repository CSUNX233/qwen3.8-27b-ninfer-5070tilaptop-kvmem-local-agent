+        qualify(MeanKIndexStorage::Device);
+        qualify(MeanKIndexStorage::HostMapped);
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "FAIL: %s\n", e.what()); return 1;
+    }
+}
