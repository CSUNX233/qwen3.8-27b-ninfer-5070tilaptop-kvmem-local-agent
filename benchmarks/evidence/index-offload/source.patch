+    for (int l = 0; l < layers; ++l) {
+        for (int b = 0; b < blocks; ++b) {
+            host_counts[l * blocks + b] = std::max(1, static_cast<int>(expected[l * stride + static_cast<std::size_t>(blocks) * width + b]));
